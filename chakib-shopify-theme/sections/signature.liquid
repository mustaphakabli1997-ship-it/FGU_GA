{%- liquid
  assign item = section.settings.product | default: collections['all'].products.first
-%}
{%- if item != blank -%}
  <section class="editorial section--ink">
    <div class="container editorial-inner">
      <div class="editorial-art reveal">
        <span class="frame" aria-hidden="true"></span>
        <div class="editorial-img">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 960px) 45vw, 90vw', alt: item.title }}
          {%- elsif item.featured_image -%}
            {{ item.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 960px) 45vw, 90vw', alt: item.title }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
      <div class="editorial-copy reveal" style="--d: 140ms">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if item.vendor != blank -%}<p class="editorial-vendor">{{ item.vendor | escape }}</p>{%- endif -%}
        <h2 class="display">{{ item.title | escape }}</h2>
        {%- if item.description != blank -%}
          <p class="lead">{{ item.description | strip_html | truncate: 220 }}</p>
        {%- endif -%}
        <div class="editorial-price">{% render 'price', product: item %}</div>
        <a class="btn btn-primary" href="{{ item.url }}">{{ section.settings.button_label | escape }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Pièce signature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Pièce signature" },
    { "type": "product", "id": "product", "label": "Produit", "info": "Sans choix : le premier produit de la boutique." },
    { "type": "image_picker", "id": "image", "label": "Image éditoriale (optionnel)", "info": "Sans image : la photo du produit." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir la pièce" }
  ],
  "presets": [
    { "name": "Pièce signature" }
  ]
}
{% endschema %}

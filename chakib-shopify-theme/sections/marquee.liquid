{%- if section.blocks.size > 0 -%}
  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker-track">
      {%- for i in (1..4) -%}
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span><svg class="orn" aria-hidden="true"><use href="#ck-crown"/></svg>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau des marques",
  "blocks": [
    {
      "type": "word",
      "name": "Marque",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Prada" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau des marques",
      "blocks": [
        { "type": "word", "settings": { "text": "Prada" } },
        { "type": "word", "settings": { "text": "Moncler" } },
        { "type": "word", "settings": { "text": "Lacoste" } },
        { "type": "word", "settings": { "text": "Balmain" } }
      ]
    }
  ]
}
{% endschema %}

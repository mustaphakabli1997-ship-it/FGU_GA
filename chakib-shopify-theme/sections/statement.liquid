<section class="statement section--ink">
  <div class="container">
    <span class="ornament" aria-hidden="true"><svg class="ico crown"><use href="#ck-crown"/></svg></span>
    <h2 class="statement-text reveal">
      <span>{{ section.settings.line_1 | escape }}</span>
      <em>{{ section.settings.line_2 | escape }}</em>
    </h2>
    {%- if section.settings.subtitle != blank -%}
      <p class="statement-sub reveal" style="--d: 100ms">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Citation / slogan",
  "settings": [
    { "type": "text", "id": "line_1", "label": "Partie 1", "default": "Le luxe n'est pas un détail," },
    { "type": "text", "id": "line_2", "label": "Partie 2 (italique doré)", "default": "c'est une signature." },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Chaque pièce est choisie pour sa coupe, sa matière et son allure. Habille-toi comme un roi." }
  ],
  "presets": [
    { "name": "Citation / slogan" }
  ]
}
{% endschema %}

<section class="section section--ivory" id="cats">
  <div class="container">
    <header class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="display">{{ section.settings.title | escape }}</h2>
    </header>

    <div class="mosaic">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            {% render 'category-tile', collection: block.settings.collection, index: forloop.index0, attrs: block.shopify_attributes %}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign shown = 0 -%}
        {%- for collection in collections -%}
          {%- if shown < 5 and collection.products_count > 0 -%}
            {% render 'category-tile', collection: collection, index: shown %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Catégories (mosaïque)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Explorer" },
    { "type": "text", "id": "title", "label": "Titre", "default": "La garde-robe idéale" },
    { "type": "paragraph", "content": "La première collection est affichée en grand. Sans bloc, les 5 premières collections de la boutique sont utilisées." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "Catégories (mosaïque)" }
  ]
}
{% endschema %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ settings.direction }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <style>:root{--primary:{{ settings.color_primary }};--ink:{{ settings.color_ink }};--accent:{{ settings.color_accent }};--bg:{{ settings.color_bg }};--white:#fff}</style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main>{{ content_for_layout }}</main>
</body>
</html>

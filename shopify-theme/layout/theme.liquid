<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ settings.direction }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" href="{{ 'logo.png' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Allura&family=Cairo:wght@400;600;700;800&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root{--primary:{{ settings.color_primary }};--ink:{{ settings.color_ink }};--accent:{{ settings.color_accent }};--bg:{{ settings.color_bg }};--white:#fff}
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <div class="app">
    {% section 'header' %}
    <main id="main">{{ content_for_layout }}</main>
    {% section 'footer' %}
  </div>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>

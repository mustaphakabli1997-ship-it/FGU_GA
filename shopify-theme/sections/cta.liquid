<section>
  <div class="wrap">
    <div class="cta">
      <h2>{{ section.settings.heading }}</h2>
      {%- if settings.whatsapp != blank -%}
        <a class="btn wa" href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "WhatsApp banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Une question ? Écrivez-nous sur WhatsApp" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Démarrer la discussion" }
  ],
  "presets": [ { "name": "WhatsApp banner" } ]
}
{% endschema %}

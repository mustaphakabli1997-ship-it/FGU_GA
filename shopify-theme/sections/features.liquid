<section>
  <div class="wrap features">
    {%- for block in section.blocks -%}
      <div class="feat" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Features",
  "blocks": [ { "type": "feature", "name": "Feature", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "توصيل لكل الولايات" },
    { "type": "text", "id": "text", "label": "Text", "default": "عدّليه حسب سياسة متجرك" }
  ] } ],
  "max_blocks": 4,
  "presets": [ { "name": "Features", "blocks": [ { "type": "feature" }, { "type": "feature" }, { "type": "feature" } ] } ]
}
{% endschema %}

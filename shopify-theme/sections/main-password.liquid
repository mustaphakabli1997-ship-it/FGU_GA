<section>
  <div class="wrap center" style="padding-top:80px">
    <img class="logoimg" style="margin:0 auto 20px;width:120px;height:120px" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="120" height="120">
    <h1 class="script" style="font-size:60px">{{ shop.name }}</h1>
    <p>{{ shop.password_message }}</p>
    {%- form 'storefront_password' -%}
      <div class="search-form" style="max-width:420px;margin:24px auto">
        <input type="password" name="password" placeholder="Mot de passe">
        <button class="btn" style="margin:0" type="submit">→</button>
      </div>
      {{ form.errors | default_errors }}
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}

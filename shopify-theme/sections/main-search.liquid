<section>
  <div class="wrap">
    <div class="title"><h2>{{ 'general.search' | t }}</h2></div>
    <form class="search-form" action="{{ routes.search_url }}" method="get">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}">
      <button class="btn" style="margin:0" type="submit">{{ 'general.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
          {%- else -%}
            <p>{{ 'general.no_results' | t }}</p>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="pagination">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a class="chip" href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="chip on">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}

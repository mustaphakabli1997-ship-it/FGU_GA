{%- assign current = product.selected_or_first_available_variant -%}
<section class="pp-sec">
  <div class="pp">
    <div class="gallery" aria-label="{{ product.title | escape }}">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          <div class="pimg"><img src="{{ media | image_url: width: 900 }}" alt="{{ media.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="900" height="1125"></div>
        {%- endif -%}
      {%- else -%}
        <div class="pimg"><svg viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5a2 2 0 1 1 2 2c-1 .3-2 1-2 2v1"/><path d="M12 10 3 17h18z"/></svg></div>
      {%- endfor -%}
    </div>
    <div class="wrap pinfo">
      <h1>{{ product.title }}</h1>
      <div class="price"><span class="js-price">{{ current.price | money }}</span>{% if current.compare_at_price > current.price %}<s>{{ current.compare_at_price | money }}</s>{% endif %}</div>
      {%- form 'product', product, id: 'pform' -%}
        <input type="hidden" name="id" id="variantId" value="{{ current.id }}">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign oi = forloop.index0 -%}
            <fieldset class="opt">
              <legend>{{ option.name }}</legend>
              {%- for value in option.values -%}
                <input type="radio" id="o{{ oi }}-{{ forloop.index0 }}" name="opt{{ oi }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                <label for="o{{ oi }}-{{ forloop.index0 }}">{{ value }}</label>
              {%- endfor -%}
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}
        <div class="stickybar">
          <div class="sprice js-price">{{ current.price | money }}</div>
          <button type="submit" name="add" id="addBtn" class="btn" data-add="{{ 'general.add_to_cart' | t }}" data-sold="{{ 'general.sold_out' | t }}"{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ 'general.add_to_cart' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}</button>
        </div>
      {%- endform -%}
      <div class="rte desc">{{ product.description }}</div>
      {%- if settings.whatsapp != blank -%}
        <a class="btn wa" target="_blank" rel="noopener" href="https://wa.me/{{ settings.whatsapp }}?text={{ product.title | append: ' ' | append: shop.url | append: product.url | url_encode }}">{{ 'general.order_whatsapp' | t }}</a>
      {%- endif -%}
    </div>
  </div>
  <script type="application/json" id="pjson">[{% for v in product.variants %}{"id":{{ v.id }},"opts":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price | money | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
</section>
{% schema %}
{ "name": "Product page", "settings": [] }
{% endschema %}

<section>
  <div class="wrap">
    <div class="title"><h2>{{ section.settings.heading }}</h2></div>
    <div class="cats">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- if c != blank -%}
            <a class="cat" href="{{ c.url }}" {{ block.shopify_attributes }}>
              {%- assign img = block.settings.image | default: c.image -%}
              {%- if img != blank -%}<img src="{{ img | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy" width="800" height="1000">{%- endif -%}
              <span>{{ c.title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for c in collections limit: 3 -%}
          <a class="cat" href="{{ c.url }}"><span>{{ c.title }}</span></a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collections",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" } ],
  "blocks": [
    { "type": "category", "name": "Collection", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Image (optional)" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Collections", "blocks": [ { "type": "category" }, { "type": "category" }, { "type": "category" } ] } ]
}
{% endschema %}

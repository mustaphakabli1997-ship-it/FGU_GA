{%- assign menu = section.settings.menu -%}
{%- if section.settings.announce != blank -%}<div class="announce">{{ section.settings.announce }}</div>{%- endif -%}
<header class="site-header">
  <div class="bar">
    <a class="iconbtn" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </a>
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        <img class="logoimg" src="{{ settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}" width="52" height="52">
      {%- else -%}
        <img class="logoimg" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="52" height="52">
      {%- endif -%}
    </a>
    <a class="iconbtn dark" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
      <span class="count">{{ cart.item_count }}</span>
    </a>
  </div>
  {%- if menu != blank and menu.links.size > 0 -%}
    <nav class="rail">
      {%- for link in menu.links -%}<a class="chip" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </nav>
  {%- endif -%}
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announce", "label": "Announcement", "default": "Paiement à la livraison — Livraison à domicile" },
    { "type": "link_list", "id": "menu", "label": "Menu (shown as swipe chips)", "default": "main-menu" }
  ]
}
{% endschema %}

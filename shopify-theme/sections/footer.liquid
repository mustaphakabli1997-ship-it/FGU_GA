<footer class="site-footer">
  <div class="wrap foot">
    {%- if settings.logo != blank -%}
      <img class="logoimg" src="{{ settings.logo | image_url: width: 160 }}" alt="{{ shop.name }}" width="72" height="72">
    {%- else -%}
      <img class="logoimg" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="72" height="72">
    {%- endif -%}
    <div>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.rights' | t }}</div>
    <div>
      {%- if settings.instagram != blank -%}<a href="{{ settings.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if settings.whatsapp != blank %} <a href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>{%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{ "name": "Footer", "settings": [] }
{% endschema %}

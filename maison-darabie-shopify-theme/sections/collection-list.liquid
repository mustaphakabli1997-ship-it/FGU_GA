<section class="section section--{{ section.settings.scheme }}" id="cats">
  <div class="container">
    <header class="section-head center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="display">{{ section.settings.title | escape }}</h2>
      {% render 'ornament' %}
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </header>

    <div class="arch-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            {% render 'category-tile', collection: block.settings.collection, index: forloop.index0, attrs: block.shopify_attributes %}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign shown = 0 -%}
        {%- for collection in collections -%}
          {%- if shown < 4 and collection.products_count > 0 -%}
            {% render 'category-tile', collection: collection, index: shown %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Univers (arches)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Univers" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Choisissez votre signature" },
    { "type": "textarea", "id": "text", "label": "Texte (optionnel)" },
    { "type": "select", "id": "scheme", "label": "Fond", "default": "ivory", "options": [ { "value": "ivory", "label": "Ivoire" }, { "value": "sand", "label": "Sable" }, { "value": "ink", "label": "Noir" } ] },
    { "type": "paragraph", "content": "Ajoutez des blocs pour choisir les collections (Homme, Femme, Mixte, Oud…). Sans bloc, les 4 premières collections de la boutique sont utilisées." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Univers (arches)" }
  ]
}
{% endschema %}

<section class="hero" data-hero>
  <div class="hero-bg" aria-hidden="true"><i class="hero-pattern"></i><i class="glow g1"></i><i class="glow g2"></i></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hero-title">
        <span class="line reveal" style="--d: 80ms">{{ section.settings.title_1 | escape }}</span>
        <span class="line reveal" style="--d: 180ms"><em>{{ section.settings.title_2 | escape }}</em></span>
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="hero-sub reveal" style="--d: 280ms">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      <div class="hero-cta reveal" style="--d: 360ms">
        {%- if section.settings.button_1_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.button_1_link | default: routes.collections_url }}">{{ section.settings.button_1_label | escape }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.button_2_link | default: routes.collections_url }}">{{ section.settings.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="hero-seals reveal" style="--d: 440ms">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <svg class="ico" aria-hidden="true"><use href="#i-{{ block.settings.icon }}"/></svg>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero-visual">
      <div class="arch-wrap reveal" style="--d: 200ms">
        <span class="arch-line l1" aria-hidden="true"></span>
        <span class="arch-line l2" aria-hidden="true"></span>
        <div class="arch hero-arch">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'arch-img', widths: '500, 750, 1000', sizes: '(min-width: 960px) 38vw, 86vw', alt: section.settings.title_1 }}
          {%- else -%}
            <span class="arch-glow" aria-hidden="true"></span>
            {% render 'bottle-art' %}
          {%- endif -%}
        </div>
      </div>
      <svg class="spark s1" aria-hidden="true"><use href="#md-star"/></svg>
      <svg class="spark s2" aria-hidden="true"><use href="#md-star"/></svg>
      <svg class="spark s3" aria-hidden="true"><use href="#md-star"/></svg>
      {%- if section.settings.seal_text != blank -%}
        <div class="seal" aria-hidden="true">
          <svg class="seal-ring" viewBox="0 0 120 120">
            <defs><path id="seal-path-{{ section.id }}" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
            <text><textPath href="#seal-path-{{ section.id }}" textLength="284" lengthAdjust="spacing">{{ section.settings.seal_text | escape }}</textPath></text>
          </svg>
          <svg class="seal-star"><use href="#md-star"/></svg>
        </div>
      {%- endif -%}
      {%- if section.settings.tag != blank -%}
        <span class="hero-tag">{{ section.settings.tag | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Héro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "100 % Original · Parfums d'exception" },
    { "type": "text", "id": "title_1", "label": "Titre — ligne 1", "default": "L'art du parfum" },
    { "type": "text", "id": "title_2", "label": "Titre — ligne 2 (italique doré)", "default": "d'Arabie" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Oud, ambre, musc et rose : une sélection de parfums 100 % originaux, livrée dans les 58 wilayas avec paiement à la livraison." },
    { "type": "text", "id": "button_1_label", "label": "Bouton 1 — texte", "default": "Découvrir la collection" },
    { "type": "url", "id": "button_1_link", "label": "Bouton 1 — lien", "default": "/collections/all" },
    { "type": "text", "id": "button_2_label", "label": "Bouton 2 — texte", "default": "Nos univers" },
    { "type": "url", "id": "button_2_link", "label": "Bouton 2 — lien", "default": "/collections" },
    { "type": "header", "content": "Visuel" },
    { "type": "image_picker", "id": "image", "label": "Photo du parfum (portrait)", "info": "Sans photo, une illustration des flacons Maison D'Arabie s'affiche." },
    { "type": "text", "id": "tag", "label": "Étiquette sur le visuel", "default": "Nouvelle collection" },
    { "type": "text", "id": "seal_text", "label": "Texte du sceau tournant", "info": "Laisser vide pour masquer le sceau.", "default": "100% ORIGINAL • PARFUMS ORIGINAUX •" }
  ],
  "blocks": [
    {
      "type": "seal",
      "name": "Atout",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Bouclier" },
            { "value": "truck", "label": "Camion" },
            { "value": "cash", "label": "Billet" },
            { "value": "gift", "label": "Cadeau" },
            { "value": "bottle", "label": "Flacon" },
            { "value": "drop", "label": "Goutte" },
            { "value": "award", "label": "Étoile" }
          ]
        },
        { "type": "text", "id": "text", "label": "Texte", "default": "100 % Original" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Héro",
      "blocks": [
        { "type": "seal", "settings": { "icon": "shield", "text": "100 % Original" } },
        { "type": "seal", "settings": { "icon": "cash", "text": "Paiement à la livraison" } },
        { "type": "seal", "settings": { "icon": "truck", "text": "58 wilayas" } }
      ]
    }
  ]
}
{% endschema %}

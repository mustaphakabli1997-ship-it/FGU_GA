{%- if section.blocks.size > 0 -%}
  <section class="section section--{{ section.settings.scheme }}" id="brands">
    <div class="container">
      <header class="section-head center reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="display">{{ section.settings.title | escape }}</h2>
        {% render 'ornament' %}
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      </header>

      <div class="brand-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign brand = block.settings.name
            if block.settings.collection != blank
              assign href = block.settings.collection.url
            else
              assign href = brand | url_for_vendor
            endif
          -%}
          <a class="brand-tile reveal" style="--d: {{ forloop.index0 | times: 90 }}ms" href="{{ href }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'brand-tile-img', loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1180px) 25vw, 50vw', alt: '' }}
            {%- endif -%}
            <span class="brand-frame" aria-hidden="true"></span>
            <span class="brand-initial" aria-hidden="true">{{ brand | slice: 0 }}</span>
            <span class="brand-info">
              <span class="brand-name">{{ brand | escape }}</span>
              {%- if block.settings.tagline != blank -%}<span class="brand-tagline">{{ block.settings.tagline | escape }}</span>{%- endif -%}
              <span class="brand-go">{{ 'general.discover' | t }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Nos marques",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Sélection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos marques" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Les plus belles signatures de la parfumerie orientale et internationale." },
    { "type": "select", "id": "scheme", "label": "Fond", "default": "ink2", "options": [ { "value": "ivory", "label": "Ivoire" }, { "value": "sand", "label": "Sable" }, { "value": "ink", "label": "Noir" }, { "value": "ink2", "label": "Noir adouci" } ] }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom de la marque", "default": "Ma marque", "info": "Si aucune collection n'est choisie, le lien affiche tous les produits dont le « Fournisseur » porte ce nom (écriture identique)." },
        { "type": "collection", "id": "collection", "label": "Collection (optionnel)" },
        { "type": "text", "id": "tagline", "label": "Légende", "default": "Parfums & coffrets" },
        { "type": "image_picker", "id": "image", "label": "Image de fond (optionnel)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Nos marques", "blocks": [ { "type": "brand", "settings": { "name": "Marque 1", "tagline": "Parfums & coffrets" } }, { "type": "brand", "settings": { "name": "Marque 2", "tagline": "Parfums & coffrets" } }, { "type": "brand", "settings": { "name": "Marque 3", "tagline": "Parfums & coffrets" } }, { "type": "brand", "settings": { "name": "Marque 4", "tagline": "Parfums & coffrets" } } ] }
  ]
}
{% endschema %}

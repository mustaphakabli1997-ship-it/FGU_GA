{%- liquid
  assign current = product.selected_or_first_available_variant
  assign active_media = current.featured_media.id | default: product.featured_media.id
  assign form_id = 'product-form-' | append: section.id
  assign show_vendor = false
  if settings.show_vendor and product.vendor != blank
    assign vendor_key = product.vendor | downcase
    assign shop_key = shop.name | downcase
    if vendor_key != shop_key
      assign show_vendor = true
    endif
  endif
-%}
<section class="product-page" data-product-section data-section-id="{{ section.id }}">
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><i>/</i>
      {%- if product.collections.size > 0 -%}
        {%- assign crumb = product.collections.first -%}
        <a href="{{ crumb.url }}">{{ crumb.title | escape }}</a><i>/</i>
      {%- endif -%}
      <span>{{ product.title | escape }}</span>
    </nav>

    <div class="product-grid">
      <div class="gallery">
        <div class="stage main-stage stage--{{ section.settings.media_fit }}" data-stage>
          {% render 'badges', product: product %}
          {%- if settings.show_seal and settings.seal_text != blank -%}
            <span class="seal-badge"><svg class="orn" aria-hidden="true"><use href="#md-star"/></svg>{{ settings.seal_text | escape }}</span>
          {%- endif -%}
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <div class="stage-slide{% if media.id == active_media %} is-active{% endif %}" data-media-id="{{ media.id }}">
                {{
                  media
                  | image_url: width: 1200
                  | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 960px) 55vw, 100vw', loading: 'eager', alt: media.alt | default: product.title
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if product.media.size == 0 -%}
            <div class="stage-slide is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 and section.settings.show_thumbs -%}
          <div class="thumbs">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <button type="button" class="thumb{% if media.id == active_media %} on{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ forloop.index }}">
                  {{ media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', alt: '' }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'title' -%}
              <div class="pi-title" {{ block.shopify_attributes }}>
                {%- if show_vendor -%}<p class="eyebrow"><a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor | escape }}</a></p>{%- endif -%}
                <h1 class="product-title">{{ product.title | escape }}</h1>
              </div>

            {%- when 'price' -%}
              <div class="product-price" data-price {{ block.shopify_attributes }}>{% render 'price', variant: current %}</div>

            {%- when 'facts' -%}
              <div {{ block.shopify_attributes }}>{% render 'product-facts', product: product, mode: 'chips' %}</div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="lead rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="pi-options" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign option_name = option.name | downcase
                      assign is_color = false
                      if option_name contains 'couleur' or option_name contains 'color' or option.name contains 'لون'
                        assign is_color = true
                      endif
                    -%}
                    <fieldset class="opt" data-option>
                      <legend>{{ option.name | escape }}{% if is_color %}: <b data-option-label>{{ option.selected_value | escape }}</b>{% endif %}</legend>
                      {%- if is_color -%}
                        <div class="swatch-list">
                          {%- for value in option.values -%}
                            <label class="swatch">
                              <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" data-position="{{ option.position }}"{% if option.selected_value == value %} checked{% endif %}>
                              {%- if value.swatch.color -%}
                                <i style="background: {{ value.swatch.color }}"></i>
                              {%- elsif value.swatch.image -%}
                                <i style="background-image: url('{{ value.swatch.image | image_url: width: 80 }}'); background-size: cover"></i>
                              {%- else -%}
                                <i class="swatch-text">{{ value | escape }}</i>
                              {%- endif -%}
                              <span class="sr">{{ value | escape }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- else -%}
                        <div class="size-list">
                          {%- for value in option.values -%}
                            <label class="size">
                              <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" data-position="{{ option.position }}"{% if option.selected_value == value %} checked{% endif %}>
                              <span>{{ value | escape }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="pi-buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
                  <div class="buy-row">
                    <div class="qty big" role="group" aria-label="{{ 'products.quantity' | t }}">
                      <button type="button" data-qty-step="-1" aria-label="-"><svg class="ico" aria-hidden="true"><use href="#i-minus"/></svg></button>
                      <input class="qty-input" type="number" name="quantity" value="1" min="1" max="20" inputmode="numeric" aria-label="{{ 'products.quantity' | t }}" data-qty-input>
                      <button type="button" data-qty-step="1" aria-label="+"><svg class="ico" aria-hidden="true"><use href="#i-plus"/></svg></button>
                    </div>
                    <button class="btn btn-primary grow" type="submit" name="add" data-add-button data-text-add="{{ 'products.add_to_cart' | t | escape }}" data-text-sold="{{ 'products.sold_out' | t | escape }}" data-text-unavailable="{{ 'products.unavailable' | t | escape }}"{% unless current.available %} disabled{% endunless %}>
                      <svg class="ico" aria-hidden="true"><use href="#i-bag"/></svg>
                      <span data-add-label>{% if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
                    </button>
                  </div>
                  <button class="btn btn-ghost btn-block" type="button" data-buy-now{% unless current.available %} disabled{% endunless %}>
                    {{ 'products.buy_now' | t }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg>
                  </button>
                  <p class="field-error" data-form-error role="alert" hidden></p>
                {%- endform -%}
              </div>

            {%- when 'notes' -%}
              <div {{ block.shopify_attributes }}>{% render 'product-facts', product: product, mode: 'notes' %}</div>

            {%- when 'assurances' -%}
              <ul class="assurances" {{ block.shopify_attributes }}>
                <li><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg>{% if block.settings.text_1 != blank %}{{ block.settings.text_1 | escape }}{% else %}{{ 'products.assure_original' | t }}{% endif %}</li>
                <li><svg class="ico" aria-hidden="true"><use href="#i-truck"/></svg>{% if block.settings.text_2 != blank %}{{ block.settings.text_2 | escape }}{% else %}{{ 'products.assure_delivery' | t }}{% endif %}</li>
                <li><svg class="ico" aria-hidden="true"><use href="#i-cash"/></svg>{% if block.settings.text_3 != blank %}{{ block.settings.text_3 | escape }}{% else %}{{ 'products.assure_cod' | t }}{% endif %}</li>
                {%- if settings.gift_wrap_enabled -%}
                  <li><svg class="ico" aria-hidden="true"><use href="#i-gift"/></svg>{% if block.settings.text_4 != blank %}{{ block.settings.text_4 | escape }}{% else %}{{ 'products.assure_gift' | t }}{% endif %}</li>
                {%- endif -%}
              </ul>

            {%- when 'collapsible' -%}
              <details class="acc" {{ block.shopify_attributes }}>
                <summary><span>{{ block.settings.heading | escape }}</span><svg class="ico" aria-hidden="true"><use href="#i-chevron"/></svg></summary>
                <div class="acc-body rte">{{ block.settings.content }}</div>
              </details>

            {%- when 'whatsapp' -%}
              {%- if settings.whatsapp_number != blank -%}
                {%- capture wa_text -%}{{ product.title }} — {{ shop.url }}{{ product.url }}{%- endcapture -%}
                <a class="btn btn-whatsapp btn-block" href="{% render 'wa-link', text: wa_text %}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                  <svg class="ico" aria-hidden="true"><use href="#i-whatsapp"/></svg>{{ 'products.whatsapp' | t }}
                </a>
              {%- endif -%}

            {%- when '@app' -%}
              {% render block %}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="sticky-buy" data-sticky-buy>
    <div><b>{{ product.title | escape }}</b><span data-sticky-price>{% render 'price', variant: current %}</span></div>
    <button class="btn btn-primary" type="button" data-sticky-add{% unless current.available %} disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
  </div>

  <script type="application/json" data-variants>{{ product.variants | json }}</script>
  {%- for variant in product.variants -%}
    <template data-price-for="{{ variant.id }}">{% render 'price', variant: variant %}</template>
  {%- endfor -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

{% schema %}
{
  "name": "Page produit",
  "settings": [
    {
      "type": "select",
      "id": "media_fit",
      "label": "Cadrage de la photo principale",
      "default": "contain",
      "options": [
        { "value": "contain", "label": "Flacon entier (idéal pour fond blanc)" },
        { "value": "cover", "label": "Remplir le cadre (photos d'ambiance)" }
      ]
    },
    { "type": "checkbox", "id": "show_thumbs", "label": "Afficher les miniatures", "default": true }
  ],
  "blocks": [
    { "type": "title", "name": "Marque et titre", "limit": 1, "settings": [] },
    { "type": "price", "name": "Prix", "limit": 1, "settings": [] },
    { "type": "facts", "name": "Fiche du parfum", "limit": 1, "settings": [] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Options (contenance…)", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "Quantité et achat", "limit": 1, "settings": [] },
    { "type": "notes", "name": "Notes olfactives", "limit": 1, "settings": [] },
    {
      "type": "assurances",
      "name": "Atouts de confiance",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text_1", "label": "Atout 1", "info": "Laisser vide pour le texte par défaut." },
        { "type": "text", "id": "text_2", "label": "Atout 2" },
        { "type": "text", "id": "text_3", "label": "Atout 3" },
        { "type": "text", "id": "text_4", "label": "Atout 4 (emballage cadeau)" }
      ]
    },
    {
      "type": "collapsible",
      "name": "Onglet déroulant",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison & paiement" },
        { "type": "richtext", "id": "content", "label": "Contenu", "default": "<p>Livraison dans les 58 wilayas, à domicile ou en point relais. Paiement à la livraison : vous réglez uniquement à la réception de votre commande.</p>" }
      ]
    },
    { "type": "whatsapp", "name": "Bouton WhatsApp", "limit": 1, "settings": [] },
    { "type": "@app" }
  ]
}
{% endschema %}

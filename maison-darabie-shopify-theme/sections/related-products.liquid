{%- liquid
  assign related_source = product.collections.first
  assign shown = 0
-%}
{%- if related_source != blank and related_source.products_count > 1 -%}
  <section class="section tight no-top">
    <div class="container related">
      <header class="section-head reveal"><h2 class="display sm">{{ 'products.related' | t }}</h2></header>
      <div class="grid">
        {%- for item in related_source.products -%}
          {%- if item.id != product.id and shown < section.settings.limit -%}
            {% render 'product-card', product: item, index: shown %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Produits similaires",
  "settings": [
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 2, "default": 4, "label": "Nombre de produits" }
  ]
}
{% endschema %}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <title>{{ shop.name }}</title>
    {% render 'meta-tags' %}
    {% style %}
      @font-face { font-family: 'Cormorant Garamond'; src: url('{{ 'cormorant-latin.woff2' | asset_url }}') format('woff2'); font-weight: 400 700; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Cormorant Garamond'; src: url('{{ 'cormorant-italic-latin.woff2' | asset_url }}') format('woff2'); font-weight: 400 700; font-style: italic; font-display: swap; }
      @font-face { font-family: 'Montserrat'; src: url('{{ 'montserrat-latin.woff2' | asset_url }}') format('woff2'); font-weight: 400 900; font-display: swap; }
      @font-face { font-family: 'Cairo'; src: url('{{ 'cairo-arabic.woff2' | asset_url }}') format('woff2'); font-weight: 200 1000; font-display: swap; }
      :root { --gold: {{ settings.color_gold }}; --gold-light: {{ settings.color_gold_light }}; --gold-dark: {{ settings.color_gold_dark }}; --ink: {{ settings.color_ink }}; --ivory: {{ settings.color_ivory }}; --sand: {{ settings.color_sand }}; --logo-h: {{ settings.logo_height | default: 46 }}px; --pattern: url('{{ 'pattern-star.svg' | asset_url }}'); }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- if settings.custom_css != blank %}
      {% style %}{{ settings.custom_css | replace: '</style', '' }}{% endstyle %}
    {%- endif %}
    {{ content_for_header }}
  </head>
  <body class="template-password{% if request.locale.iso_code == 'ar' %} is-ar{% endif %}" data-route="password">
    {% render 'icons' %}
    <main id="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>

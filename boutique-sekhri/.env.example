# Copie ce fichier en `.env` puis adapte les valeurs. Ne le publie jamais (il est dans .gitignore).

# --- Site -------------------------------------------------------------------
PORT=3000
# Adresse publique du site (utilisée dans les liens des emails). Ex : https://www.boutique-sekhri.dz
SITE_URL=http://localhost:3000
# En production : NODE_ENV=production (le mot de passe admin devient obligatoire, cookies sécurisés si SITE_URL est en https)
NODE_ENV=development
# Derrière nginx / Cloudflare / un hébergeur avec proxy : TRUST_PROXY=1
TRUST_PROXY=

# --- Administration (/admin) ------------------------------------------------
# Mot de passe de la boutique. Choisis-en un long et unique.
ADMIN_PASSWORD=
# Optionnel : clé de signature des sessions admin (sinon dérivée du mot de passe)
SESSION_SECRET=

# --- Emails (newsletter + commandes) ----------------------------------------
# Sans SMTP_HOST, les emails ne sont PAS envoyés : ils sont enregistrés dans data/outbox pour prévisualisation.
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465, false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché. Doit appartenir à un domaine/compte autorisé par ton fournisseur.
MAIL_FROM=Boutique Sekhri <contact@ton-domaine.dz>
# Reçoit une notification à chaque nouvelle commande
OWNER_EMAIL=
# Pause entre deux emails d'une campagne (ms) pour respecter les limites du fournisseur
MAIL_DELAY_MS=400

# --- Livraison (en DA) -------------------------------------------------------
SHIPPING_HOME=700
SHIPPING_DESK=450
FREE_SHIPPING_FROM=15000

# --- Coordonnées affichées dans le pied de page (laisse vide pour masquer) ----
# WhatsApp : numéro au format international sans + (ex : 213550123456) -> bouton WhatsApp flottant
CONTACT_WHATSAPP=
CONTACT_INSTAGRAM=
CONTACT_FACEBOOK=
CONTACT_TIKTOK=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_ADDRESS=

# --- Données ------------------------------------------------------------------
# Dossier de la base (db.json) et des images uploadées. À conserver entre deux déploiements !
# DATA_DIR=./data
# false = démarrer sans les produits de démonstration
SEED_DEMO=true

<section class="section" id="faq">
  <div class="container">
    <div class="section__head section__head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="title-chrome section__title">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }} {% render 'icon', name: 'chevron' %}</summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "الأسئلة الشائعة",
  "tag": "div",
  "max_blocks": 14,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "عنوان صغير", "default": "أسئلة متكررة" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "الأسئلة الشائعة" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "سؤال",
      "settings": [
        { "type": "text", "id": "question", "label": "السؤال", "default": "كيف أطلب؟" },
        { "type": "richtext", "id": "answer", "label": "الجواب", "default": "<p>اختر الموديل واللون والمقاس، املأ الاستمارة ثم أكّد الطلب.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "الأسئلة الشائعة",
      "blocks": [
        { "type": "question", "settings": { "question": "كيف أطلب؟", "answer": "<p>اختر الموديل واللون والمقاس، املأ الاستمارة (الاسم، الهاتف، الولاية، العنوان) ثم أكّد الطلب. لا نطلب أي دفع عبر الإنترنت.</p>" } },
        { "type": "question", "settings": { "question": "كيف يتم الدفع؟", "answer": "<p>نعتمد سياسة الدفع عند الاستلام: لا نطلب أي مبلغ مسبق، وتدفع ثمن المنتج نقدًا عند تسليمه فقط، للموزّع (التوصيل إلى المنزل) أو في مكتب شركة التوصيل (Stop Desk). ترفق مع طلبيتك فاتورة موقّعة ومصادق عليها من طرف الشركة.</p>" } },
        { "type": "question", "settings": { "question": "هل يمكنني الدفع بالبطاقة البنكية؟", "answer": "<p>لا. لا نقبل الدفع بالبطاقة: لا يوجد دفع عبر الإنترنت ولا نطلب منك أي معلومات بنكية. تدفع نقدًا عند الاستلام.</p>" } },
        { "type": "question", "settings": { "question": "كم سعر التوصيل؟", "answer": "<p>400 دج للتوصيل إلى المكتب (Stop Desk) و600 دج للتوصيل إلى المنزل، في كل الولايات الـ58.</p>" } },
        { "type": "question", "settings": { "question": "متى تصلني طلبيتي؟", "answer": "<p>نتصل بك خلال 24 ساعة من وضع الطلبية لتأكيدها هاتفيًا، ثم تُسلَّم الطلبية في غضون 2 إلى 7 أيام حسب الولاية.</p>" } },
        { "type": "question", "settings": { "question": "المنزل أم المكتب، ماذا أختار؟", "answer": "<p>إلى المنزل: الموزّع يتصل بك ويوصل الطلبية إليك. إلى المكتب (Stop Desk): تستلم طلبيتك من مكتب شركة التوصيل في بلديتك بسعر أقل.</p>" } },
        { "type": "question", "settings": { "question": "كيف أختار المقاس؟", "answer": "<p>المقاسات المتوفرة مذكورة في صفحة كل منتج. إذا ترددت بين مقاسين، تواصل معنا قبل الطلب.</p>" } },
        { "type": "question", "settings": { "question": "ماذا لو كان المنتج معطوبًا؟", "answer": "<p>نلتزم بتعويض زبائننا إذا وُجد المنتج معطوبًا أو مكسورًا أو فيه خلل. تواصل معنا عند الاستلام.</p>" } },
        { "type": "question", "settings": { "question": "هل يتم تأكيد طلبي بالهاتف؟", "answer": "<p>نعم. بعد الطلب يتصل بك فريقنا لتأكيد التفاصيل، لذا تأكد من رقم هاتفك في الاستمارة.</p>" } }
      ]
    }
  ]
}
{% endschema %}

<section class="section" id="faq">
  <div class="container">
    <div class="section__head section__head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="title-chrome section__title">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }} {% render 'icon', name: 'chevron' %}</summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "max_blocks": 14,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Questions fréquentes" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "FAQ" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Comment passer commande ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Ouvrez le modèle qui vous plaît, choisissez votre pointure, remplissez le formulaire puis validez.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Comment passer commande ?", "answer": "<p>Choisissez votre modèle, votre couleur et votre pointure, remplissez le formulaire (nom, téléphone, wilaya, adresse) puis validez. Aucun paiement en ligne n'est demandé.</p>" } },
        { "type": "question", "settings": { "question": "Comment se passe le paiement ?", "answer": "<p>Nous ne demandons aucun paiement à l'avance. Vous payez uniquement à la livraison, en espèces : au livreur (livraison à domicile) ou au bureau du transporteur (Stop Desk). Une facture signée et cachetée par la société accompagne votre commande.</p>" } },
        { "type": "question", "settings": { "question": "Puis-je payer par carte bancaire ?", "answer": "<p>Non. Nous n'acceptons aucun paiement par carte : il n'y a pas de paiement en ligne et aucune donnée bancaire ne vous est demandée. Vous payez en espèces à la réception.</p>" } },
        { "type": "question", "settings": { "question": "Combien coûte la livraison ?", "answer": "<p>400 DA en Stop Desk (retrait au bureau du transporteur) et 600 DA pour la livraison à domicile, partout en Algérie (58 wilayas).</p>" } },
        { "type": "question", "settings": { "question": "Quels sont les délais de livraison ?", "answer": "<p>Notre équipe vous appelle dans les 24 heures suivant votre commande pour la confirmer avec vous. La livraison est ensuite effectuée en 2 à 7 jours selon votre wilaya.</p>" } },
        { "type": "question", "settings": { "question": "Domicile ou Stop Desk, que choisir ?", "answer": "<p>À domicile : le livreur vous appelle et vous apporte le colis. Stop Desk : vous récupérez le colis au bureau du transporteur de votre commune, pour un tarif plus bas.</p>" } },
        { "type": "question", "settings": { "question": "Comment choisir ma pointure ?", "answer": "<p>Les pointures disponibles sont indiquées sur chaque fiche produit. Si vous hésitez entre deux tailles, contactez-nous avant de commander.</p>" } },
        { "type": "question", "settings": { "question": "Que faire si mon produit est défectueux ?", "answer": "<p>Si votre produit est endommagé, cassé ou présente un défaut, nous nous engageons à vous dédommager. Contactez-nous dès la réception.</p>" } },
        { "type": "question", "settings": { "question": "Ma commande est-elle confirmée par téléphone ?", "answer": "<p>Oui. Après votre commande, notre équipe vous appelle pour confirmer les détails. Vérifiez bien votre numéro de téléphone dans le formulaire.</p>" } }
      ]
    }
  ]
}
{% endschema %}

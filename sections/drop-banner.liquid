<section class="section section--alt" id="drops">
  <div class="container drop">
    <div class="drop__looks" data-reveal>
      {%- if section.settings.stamp != blank -%}
        <span class="drop__stamp">{{ section.settings.stamp | escape }}</span>
      {%- endif -%}
      <figure>
        {%- if section.settings.image_1 != blank -%}
          {{ section.settings.image_1 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 900px) 22vw, 45vw', alt: section.settings.image_1.alt | default: section.settings.heading }}
        {%- else -%}
          <img src="{{ 'youz-look-1.jpg' | asset_url }}" alt="" width="800" height="880" loading="lazy">
        {%- endif -%}
      </figure>
      <figure>
        {%- if section.settings.image_2 != blank -%}
          {{ section.settings.image_2 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 900px) 22vw, 45vw', alt: section.settings.image_2.alt | default: section.settings.heading }}
        {%- else -%}
          <img src="{{ 'youz-look-2.jpg' | asset_url }}" alt="" width="800" height="880" loading="lazy">
        {%- endif -%}
      </figure>
    </div>

    <div data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="title-chrome">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="drop__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--white btn--lg" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "قسم التشكيلة",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "عنوان صغير", "default": "تشكيلتنا" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "أناقة وراحة كل يوم" },
    {
      "type": "textarea",
      "id": "text",
      "label": "النص",
      "default": "أحذية رياضية، صابو وموكاسان بتصميم عصري يجمع بين الراحة والأناقة: خفيفة الوزن، بنعل مريح مانع للانزلاق، وبألوان راقية لإطلالة كاجوال مثالية للاستخدام اليومي."
    },
    { "type": "text", "id": "stamp", "label": "الختم", "default": "تشكيلة جديدة" },
    { "type": "text", "id": "button_label", "label": "الزر — النص", "default": "شاهد التشكيلة" },
    { "type": "url", "id": "button_link", "label": "الزر — الرابط" },
    { "type": "image_picker", "id": "image_1", "label": "الصورة 1", "info": "فارغ = صورة من منتجاتك مدمجة في الثيم." },
    { "type": "image_picker", "id": "image_2", "label": "الصورة 2", "info": "فارغ = صورة من منتجاتك مدمجة في الثيم." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "ميزة",
      "settings": [
        { "type": "text", "id": "text", "label": "النص", "default": "خامات عالية الجودة لمتانة تدوم طويلًا" }
      ]
    }
  ],
  "presets": [
    {
      "name": "قسم التشكيلة",
      "blocks": [
        { "type": "feature", "settings": { "text": "خامات عالية الجودة لمتانة تدوم طويلًا" } },
        { "type": "feature", "settings": { "text": "خفيفة الوزن بنعل مريح مانع للانزلاق" } },
        { "type": "feature", "settings": { "text": "ألوان راقية لإطلالة كاجوال يومية" } }
      ]
    }
  ]
}
{% endschema %}

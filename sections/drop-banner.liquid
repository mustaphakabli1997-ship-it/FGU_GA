<section class="section section--alt" id="drops">
  <div class="container drop">
    <div class="drop__looks" data-reveal>
      {%- if section.settings.stamp != blank -%}
        <span class="drop__stamp">{{ section.settings.stamp | escape }}</span>
      {%- endif -%}
      <figure>
        {%- if section.settings.image_1 != blank -%}
          {{ section.settings.image_1 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 900px) 22vw, 45vw', alt: section.settings.image_1.alt | default: section.settings.heading }}
        {%- else -%}
          <img src="{{ 'youz-look-1.jpg' | asset_url }}" alt="" width="800" height="880" loading="lazy">
        {%- endif -%}
      </figure>
      <figure>
        {%- if section.settings.image_2 != blank -%}
          {{ section.settings.image_2 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 900px) 22vw, 45vw', alt: section.settings.image_2.alt | default: section.settings.heading }}
        {%- else -%}
          <img src="{{ 'youz-look-2.jpg' | asset_url }}" alt="" width="800" height="880" loading="lazy">
        {%- endif -%}
      </figure>
    </div>

    <div data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="title-chrome">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="drop__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--white btn--lg" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Le drop (éditorial)",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le drop" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le confort à chaque pas" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Baskets, sabots et mocassins au design moderne : des modèles légers, avec une semelle confortable et antidérapante, pour un look casual au quotidien."
    },
    { "type": "text", "id": "stamp", "label": "Tampon", "default": "Nouvelle collection" },
    { "type": "text", "id": "button_label", "label": "Bouton — texte", "default": "Voir la collection" },
    { "type": "url", "id": "button_link", "label": "Bouton — lien" },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1", "info": "Vide = photo d'exemple du thème." },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2", "info": "Vide = photo d'exemple du thème." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Point fort",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Matériaux de haute qualité, pour une durabilité qui dure" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Le drop (éditorial)",
      "blocks": [
        { "type": "feature", "settings": { "text": "Matériaux de haute qualité, pour une durabilité qui dure" } },
        { "type": "feature", "settings": { "text": "Légères, avec une semelle confortable et antidérapante" } },
        { "type": "feature", "settings": { "text": "Coloris raffinés pour un look casual au quotidien" } }
      ]
    }
  ]
}
{% endschema %}

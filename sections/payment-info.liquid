<section class="section section--alt" id="paiement">
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="title-chrome section__title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <p>{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    <div class="payinfo">
      <article class="payinfo__card payinfo__card--yes" data-reveal>
        <span class="payinfo__tag">مقبول</span>
        <div class="payinfo__icon">{% render 'icon', name: 'cash' %}</div>
        <h3>{{ section.settings.yes_title | escape }}</h3>
        <p>{{ section.settings.yes_text | escape }}</p>
        {%- if section.blocks.size > 0 -%}
          <ul class="payinfo__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </article>

      <article class="payinfo__card payinfo__card--no" data-reveal>
        <span class="payinfo__tag">غير متوفر</span>
        <div class="payinfo__icon">{% render 'icon', name: 'card-off' %}</div>
        <h3>{{ section.settings.no_title | escape }}</h3>
        <p>{{ section.settings.no_text | escape }}</p>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "طرق الدفع",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "عنوان صغير", "default": "بدون مخاطرة" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "طرق الدفع" },
    { "type": "textarea", "id": "intro", "label": "مقدمة", "default": "مع YOUZ لا تدفع إلا عندما تكون طلبيتك بين يديك." },
    { "type": "text", "id": "yes_title", "label": "بطاقة «مقبول» — العنوان", "default": "الدفع عند الاستلام" },
    { "type": "textarea", "id": "yes_text", "label": "بطاقة «مقبول» — النص", "default": "لا نطلب أي مبلغ مسبق: تدفع نقدًا فقط عند استلام طلبيتك." },
    { "type": "text", "id": "no_title", "label": "بطاقة «غير متوفر» — العنوان", "default": "البطاقة البنكية" },
    { "type": "textarea", "id": "no_text", "label": "بطاقة «غير متوفر» — النص", "default": "لا دفع بالبطاقة: لا دفع عبر الإنترنت ولا نطلب منك أي معلومات بنكية." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "نقطة",
      "settings": [
        { "type": "text", "id": "text", "label": "النص", "default": "للموزّع إذا اخترت التوصيل إلى المنزل" }
      ]
    }
  ],
  "presets": [
    {
      "name": "طرق الدفع",
      "blocks": [
        { "type": "point", "settings": { "text": "للموزّع إذا اخترت التوصيل إلى المنزل" } },
        { "type": "point", "settings": { "text": "في مكتب شركة التوصيل إذا اخترت Stop Desk" } },
        { "type": "point", "settings": { "text": "المبلغ الكامل يظهر قبل تأكيد الطلب" } },
        { "type": "point", "settings": { "text": "ترفق مع طلبيتك فاتورة موقّعة ومصادق عليها" } }
      ]
    }
  ]
}
{% endschema %}

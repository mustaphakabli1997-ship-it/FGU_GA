{%- assign featured = section.settings.product -%}

<section class="hero">
  <i class="drip" style="left:6%;top:0;height:120px"></i>
  <i class="drip" style="right:5%;top:0;height:170px"></i>
  <div class="container hero__grid">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="sr-only">{{ shop.name | escape }}</h1>
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 1400 | image_tag: class: 'hero__logo', alt: shop.name, loading: 'eager', fetchpriority: 'high', widths: '480, 720, 1000, 1400', sizes: '(min-width: 900px) 56vw, 100vw' }}
      {%- else -%}
        <img class="hero__logo" src="{{ 'youz-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1400" height="541" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="hero__title">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
      {%- if section.settings.lead != blank -%}
        <p class="hero__lead">{{ section.settings.lead | escape }}</p>
      {%- endif -%}
      <div class="hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--white btn--lg" href="{{ section.settings.button_link | default: '#passer-commande' }}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn--lg" href="{{ section.settings.button_2_link | default: '#commander' }}">{{ section.settings.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
      <ul class="hero__perks">
        <li>{% render 'icon', name: 'truck' %} التوصيل إلى 58 ولاية</li>
        <li>{% render 'icon', name: 'cash' %} الدفع عند الاستلام فقط</li>
        <li>{% render 'icon', name: 'clock' %} الطلب في دقيقة</li>
      </ul>
    </div>

    <a class="feature-card" href="{{ featured.url | default: routes.all_products_collection_url }}">
      <div class="feature-card__in">
        {%- if section.settings.badge != blank -%}
          <span class="stamp">{{ section.settings.badge | escape }}</span>
        {%- endif -%}
        {% render 'icon', name: 'star', class: 'star i--fill' %}
        {%- if featured.featured_image != blank -%}
          {{ featured.featured_image | image_url: width: 900 | image_tag: width: 675, height: 734, alt: featured.title, widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 34vw, 90vw' }}
        {%- else -%}
          <img src="{{ 'youz-hero-shoe.jpg' | asset_url }}" alt="" width="675" height="734">
        {%- endif -%}
        <div class="feature-card__meta">
          <div>
            {%- if featured != blank -%}
              <h3>{{ featured.title | escape }}</h3>
              <p>{% render 'price', amount: featured.price %}</p>
            {%- else -%}
              <h3>{{ shop.name | escape }}</h3>
              <p>تشكيلة جديدة</p>
            {%- endif -%}
          </div>
          <span class="btn btn--white btn--sm">اطلب الآن</span>
        </div>
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "واجهة YOUZ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "عنوان صغير", "default": "أحذية عصرية · الجزائر" },
    { "type": "image_picker", "id": "logo", "label": "شعار كبير (اختياري)", "info": "PNG شفاف. فارغ = شعار YOUZ الكروم." },
    { "type": "text", "id": "tagline", "label": "الشعار النصي", "default": "راحتك في كل خطوة" },
    {
      "type": "textarea",
      "id": "lead",
      "label": "نص تعريفي",
      "default": "خطواتك بأناقة: نقدّم أحذية عصرية، مريحة، وبأسعار تناسب الجميع. اطلب في دقيقة، استلم في بيتك وادفع نقدًا عند الاستلام — بدون بطاقة بنكية."
    },
    { "type": "text", "id": "button_label", "label": "الزر 1 — النص", "default": "اطلب الآن" },
    { "type": "url", "id": "button_link", "label": "الزر 1 — الرابط", "info": "فارغ = ينزل إلى استمارة «اطلب الآن»." },
    { "type": "text", "id": "button_2_label", "label": "الزر 2 — النص", "default": "كيف أطلب؟" },
    { "type": "url", "id": "button_2_link", "label": "الزر 2 — الرابط", "info": "فارغ = ينزل إلى قسم «كيف أطلب؟»." },
    { "type": "header", "content": "المنتج المميز" },
    { "type": "product", "id": "product", "label": "المنتج المميز" },
    { "type": "text", "id": "badge", "label": "شارة (اختياري)", "default": "" }
  ],
  "presets": [
    { "name": "واجهة YOUZ" }
  ]
}
{% endschema %}

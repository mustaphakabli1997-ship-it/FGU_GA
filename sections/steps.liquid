<section class="section" id="commander">
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="title-chrome section__title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <p>{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" data-reveal {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "كيف أطلب؟",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "عنوان صغير", "default": "بسيط وسريع" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "كيف أطلب؟" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "مقدمة",
      "default": "بدون حساب وبدون بطاقة بنكية: تملأ الاستمارة وتدفع نقدًا عند الاستلام."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "خطوة",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "الأيقونة",
          "options": [
            { "value": "package", "label": "طرد" },
            { "value": "pin", "label": "موقع" },
            { "value": "truck", "label": "شاحنة" },
            { "value": "phone", "label": "هاتف" },
            { "value": "shield", "label": "درع" },
            { "value": "check", "label": "علامة صح" }
          ],
          "default": "package"
        },
        { "type": "text", "id": "title", "label": "العنوان", "default": "اختر حذاءك" },
        { "type": "textarea", "id": "text", "label": "النص", "default": "تصفّح التشكيلة واختر الموديل واللون والمقاس." }
      ]
    }
  ],
  "presets": [
    {
      "name": "كيف أطلب؟",
      "blocks": [
        { "type": "step", "settings": { "icon": "package", "title": "اختر حذاءك", "text": "تصفّح التشكيلة واختر الموديل واللون والمقاس." } },
        { "type": "step", "settings": { "icon": "pin", "title": "املأ الاستمارة", "text": "الاسم، الهاتف، الولاية والعنوان فقط. المجموع يظهر مباشرة." } },
        { "type": "step", "settings": { "icon": "truck", "title": "استلم وادفع", "text": "نتصل بك خلال 24 ساعة للتأكيد، ثم تدفع نقدًا عند الاستلام." } }
      ]
    }
  ]
}
{% endschema %}

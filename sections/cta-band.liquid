<section class="container cta-wrap">
  <div class="cta-band" data-reveal>
    <h2 class="title-chrome">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--white btn--lg" href="{{ section.settings.button_link | default: '#passer-commande' }}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "البانر الأخير",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "لا تفوّت جديدنا" },
    { "type": "textarea", "id": "text", "label": "النص", "default": "اطلب الآن، استلم في بيتك وادفع نقدًا عند الاستلام." },
    { "type": "text", "id": "button_label", "label": "الزر — النص", "default": "اطلب الآن" },
    { "type": "url", "id": "button_link", "label": "الزر — الرابط" }
  ],
  "presets": [
    { "name": "البانر الأخير" }
  ]
}
{% endschema %}

{%- if section.blocks.size > 0 -%}
  {%- capture items -%}
    {%- for block in section.blocks -%}
      <span class="marquee__item">{{ block.settings.text | escape }}{% render 'icon', name: 'star', class: 'i--fill' %}</span>
    {%- endfor -%}
  {%- endcapture -%}
  <div class="marquee" aria-label="Informations">
    <div class="marquee__track">{{ items }}{{ items }}{{ items }}{{ items }}</div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau défilant",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison dans les 58 wilayas" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Livraison dans les 58 wilayas" } },
      { "type": "message", "settings": { "text": "Paiement à la livraison" } },
      { "type": "message", "settings": { "text": "Confirmation par téléphone" } },
      { "type": "message", "settings": { "text": "Stock limité · Drops exclusifs" } }
    ]
  }
}
{% endschema %}

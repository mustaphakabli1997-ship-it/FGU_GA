{%- if section.blocks.size > 0 -%}
  {%- capture items -%}
    {%- for block in section.blocks -%}
      <span class="marquee__item">{{ block.settings.text | escape }}{% render 'icon', name: 'star', class: 'i--fill' %}</span>
    {%- endfor -%}
  {%- endcapture -%}
  <div class="marquee" aria-label="معلومات">
    <div class="marquee__track">{{ items }}{{ items }}{{ items }}{{ items }}</div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "شريط الإعلانات",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "message",
      "name": "رسالة",
      "settings": [
        { "type": "text", "id": "text", "label": "النص", "default": "التوصيل إلى 58 ولاية" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "التوصيل إلى 58 ولاية" } },
      { "type": "message", "settings": { "text": "الدفع عند الاستلام" } },
      { "type": "message", "settings": { "text": "تأكيد الطلب بالهاتف خلال 24 ساعة" } },
      { "type": "message", "settings": { "text": "راحتك في كل خطوة" } }
    ]
  }
}
{% endschema %}

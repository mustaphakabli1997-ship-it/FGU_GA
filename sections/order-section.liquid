{%- assign collection_to_show = section.settings.collection | default: collections['all'] -%}

<section class="section section--order" id="passer-commande">
  <div class="container order-section">
    <div class="order-section__intro" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="title-chrome section__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="order-section__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <ol class="order-points">
        <li><span>1</span> Choisissez votre modèle et votre pointure</li>
        <li><span>2</span> Remplissez vos informations de livraison</li>
        <li><span>3</span> Payez en espèces à la réception de votre colis</li>
      </ol>

      <div class="paycard">
        <div class="paycard__row paycard__row--yes">
          {% render 'icon', name: 'cash' %}
          <div><strong>Paiement à la livraison</strong><span>Espèces, au livreur ou au bureau du transporteur.</span></div>
        </div>
        <div class="paycard__row paycard__row--no">
          {% render 'icon', name: 'card-off' %}
          <div><strong>Pas de paiement par carte</strong><span>Aucun paiement en ligne, aucune donnée bancaire demandée.</span></div>
        </div>
      </div>
    </div>

    <div data-reveal>
      {% render 'order-form',
        mode: 'home',
        collection: collection_to_show,
        limit: section.settings.product_count,
        title: section.settings.form_title,
        subtitle: section.settings.form_subtitle,
        button_label: section.settings.button_label
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Passer commande (accueil)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Commande en 1 minute" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Passer commande" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Choisissez votre paire ici, sans quitter la page. Le paiement se fait uniquement à la livraison, en espèces."
    },
    { "type": "collection", "id": "collection", "label": "Modèles proposés", "info": "Vide = tous les produits disponibles." },
    { "type": "range", "id": "product_count", "label": "Nombre de modèles", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "form_title", "label": "Titre du formulaire", "default": "Votre commande" },
    {
      "type": "text",
      "id": "form_subtitle",
      "label": "Sous-titre du formulaire",
      "default": "Remplissez le formulaire : vous payez en espèces à la livraison."
    },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Confirmer la commande" }
  ],
  "presets": [
    { "name": "Passer commande (accueil)" }
  ]
}
{% endschema %}

{%- assign collection_to_show = section.settings.collection | default: collections['all'] -%}

<section class="section section--order" id="passer-commande">
  <div class="container order-section">
    <div class="order-section__intro" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="title-chrome section__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="order-section__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <ol class="order-points">
        <li><span>1</span> اختر الموديل واللون والمقاس</li>
        <li><span>2</span> املأ معلومات التوصيل</li>
        <li><span>3</span> ادفع نقدًا عند استلام طلبيتك</li>
      </ol>

      <div class="paycard">
        <div class="paycard__row paycard__row--yes">
          {% render 'icon', name: 'cash' %}
          <div><strong>الدفع عند الاستلام</strong><span>نقدًا، للموزّع أو في مكتب شركة التوصيل.</span></div>
        </div>
        <div class="paycard__row paycard__row--no">
          {% render 'icon', name: 'card-off' %}
          <div><strong>لا دفع بالبطاقة</strong><span>لا دفع عبر الإنترنت ولا نطلب أي معلومات بنكية.</span></div>
        </div>
      </div>
    </div>

    <div data-reveal>
      {% render 'order-form',
        mode: 'home',
        collection: collection_to_show,
        limit: section.settings.product_count,
        title: section.settings.form_title,
        subtitle: section.settings.form_subtitle,
        button_label: section.settings.button_label
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "اطلب الآن (الرئيسية)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "عنوان صغير", "default": "الطلب في دقيقة" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "اطلب الآن" },
    {
      "type": "textarea",
      "id": "text",
      "label": "النص",
      "default": "اختر حذاءك من هنا دون مغادرة الصفحة. الدفع يكون فقط عند الاستلام، نقدًا."
    },
    { "type": "collection", "id": "collection", "label": "الموديلات المعروضة", "info": "فارغ = كل المنتجات المتوفرة." },
    { "type": "range", "id": "product_count", "label": "عدد الموديلات", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "form_title", "label": "عنوان الاستمارة", "default": "طلبيتك" },
    { "type": "text", "id": "form_subtitle", "label": "النص تحت العنوان", "default": "املأ الاستمارة: تدفع نقدًا عند الاستلام." },
    { "type": "text", "id": "button_label", "label": "نص الزر", "default": "تأكيد الطلب" }
  ],
  "presets": [
    { "name": "اطلب الآن (الرئيسية)" }
  ]
}
{% endschema %}

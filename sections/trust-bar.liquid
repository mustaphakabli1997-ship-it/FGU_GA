<section class="trust" aria-label="التزاماتنا">
  <div class="container trust__grid">
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon %}
        <div>
          <strong>{{ block.settings.title | escape }}</strong>
          <span>{{ block.settings.text | escape }}</span>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "شريط الالتزامات",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "التزام",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "الأيقونة",
          "options": [
            { "value": "truck", "label": "شاحنة" },
            { "value": "shield", "label": "درع" },
            { "value": "phone", "label": "هاتف" },
            { "value": "check", "label": "علامة صح" },
            { "value": "cash", "label": "نقود" },
            { "value": "package", "label": "طرد" },
            { "value": "clock", "label": "ساعة" },
            { "value": "pin", "label": "موقع" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "العنوان", "default": "التوصيل إلى 58 ولاية" },
        { "type": "text", "id": "text", "label": "النص", "default": "إلى المنزل أو إلى المكتب" }
      ]
    }
  ],
  "presets": [
    {
      "name": "شريط الالتزامات",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "التوصيل إلى 58 ولاية", "text": "إلى المنزل أو إلى المكتب (Stop Desk)" } },
        { "type": "item", "settings": { "icon": "shield", "title": "الدفع عند الاستلام", "text": "نقدًا · بدون بطاقة بنكية" } },
        { "type": "item", "settings": { "icon": "phone", "title": "تأكيد خلال 24 ساعة", "text": "فريقنا يتصل بك" } },
        { "type": "item", "settings": { "icon": "check", "title": "الضمان", "text": "تعويض المنتج المعطوب" } }
      ]
    }
  ]
}
{% endschema %}

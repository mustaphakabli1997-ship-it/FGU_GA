{%- liquid
  assign fee_home_cents = settings.fee_home | default: 0 | times: 100
  assign fee_desk_cents = settings.fee_desk | default: 0 | times: 100
  assign free_over = settings.free_delivery_over | default: 0 | times: 100
-%}
<section class="section" id="livraison">
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="title-chrome section__title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <p>{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    <div class="rates">
      <article class="rate" data-reveal>
        <div class="rate__icon">{% render 'icon', name: 'pin' %}</div>
        <h3>إلى المكتب (Stop Desk)</h3>
        <p>استلم طلبيتك من مكتب شركة التوصيل في بلديتك.</p>
        <strong class="rate__price">{% render 'price', amount: fee_desk_cents %}</strong>
      </article>
      <article class="rate" data-reveal>
        <div class="rate__icon">{% render 'icon', name: 'home' %}</div>
        <h3>إلى المنزل</h3>
        <p>الموزّع يوصل طلبيتك إلى باب بيتك.</p>
        <strong class="rate__price">{% render 'price', amount: fee_home_cents %}</strong>
      </article>
    </div>

    <p class="note">
      {% render 'icon', name: 'info' %}
      <span>سعر موحّد لكل الولايات الـ58. الدفع نقدًا عند الاستلام.
        {%- if settings.free_delivery_over > 0 %} التوصيل مجاني ابتداءً من {% render 'price', amount: free_over %} للطلبية.{% endif -%}
      </span>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "أسعار التوصيل",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "عنوان صغير", "default": "58 ولاية" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "التوصيل" },
    { "type": "textarea", "id": "intro", "label": "مقدمة", "default": "سعر واحد في كل الجزائر: إلى المنزل أو إلى المكتب (Stop Desk)." },
    { "type": "paragraph", "content": "الأسعار تُعدَّل من: إعدادات الثيم ← استمارة الطلب والتوصيل." }
  ],
  "presets": [
    { "name": "أسعار التوصيل" }
  ]
}
{% endschema %}

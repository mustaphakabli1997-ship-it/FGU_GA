{%- comment -%}شارات طريقة الدفع : نقدًا عند الاستلام (نعم) / البطاقة البنكية (لا).{%- endcomment -%}
<div class="paybadges">
  <span class="paybadge paybadge--yes">{% render 'icon', name: 'cash' %} الدفع عند الاستلام</span>
  <span class="paybadge paybadge--no">{% render 'icon', name: 'card-off' %} البطاقة البنكية غير مقبولة</span>
</div>

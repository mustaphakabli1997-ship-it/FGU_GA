{%- comment -%} Params: paginate {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}
      <a class="chip" href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a class="chip sm" href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="chip sm on" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="chip sm">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a class="chip" href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>
    {%- endif -%}
  </nav>
{%- endif -%}

<section class="hero" data-hero>
  <div class="hero-copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow reveal"><span class="idx">01</span>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="hero-title">
      <span class="line reveal" style="--d: 80ms">{{ section.settings.title_1 | escape }}</span>
      <span class="line gold reveal" style="--d: 180ms">{{ section.settings.title_2 | escape }}</span>
    </h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="hero-sub reveal" style="--d: 280ms">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    <div class="hero-cta reveal" style="--d: 360ms">
      {%- if section.settings.button_1_label != blank -%}
        <a class="btn" href="{{ section.settings.button_1_link | default: routes.collections_url }}">{{ section.settings.button_1_label | escape }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="link" href="{{ section.settings.button_2_link | default: routes.collections_url }}">{{ section.settings.button_2_label | escape }}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="hero-facts reveal" style="--d: 440ms">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <svg class="ico" aria-hidden="true"><use href="#i-{{ block.settings.icon }}"/></svg>
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="hero-stage on-dark">
    <div class="stage-bg" aria-hidden="true"></div>
    <img class="stage-mono" src="{{ 'monogram.svg' | asset_url }}" alt="" width="715" height="711">
    <div class="stage-art">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'stage-img', widths: '550, 800, 1100', sizes: '(min-width: 960px) 46vw, 100vw', alt: section.settings.title_1 }}
      {%- else -%}
        {% render 'bottle-art' %}
      {%- endif -%}
    </div>
    <span class="oct-line" aria-hidden="true"></span>
    {%- if section.settings.tag != blank -%}
      <span class="stage-tag">{{ section.settings.tag | escape }}</span>
    {%- endif -%}
    {% render 'seal', text: section.settings.seal_text, uid: section.id %}
  </div>
</section>

{% schema %}
{
  "name": "Héro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "أصلية 100% · عطور استثنائية" },
    { "type": "text", "id": "title_1", "label": "Titre — ligne 1", "default": "فنّ العطر" },
    { "type": "text", "id": "title_2", "label": "Titre — ligne 2 (en or)", "default": "العربي الأصيل" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "عود وعنبر ومسك ووردة: تشكيلة من العطور الأصلية 100%، تصلك إلى 58 ولاية مع الدفع عند الاستلام." },
    { "type": "text", "id": "button_1_label", "label": "Bouton — texte", "default": "اكتشف التشكيلة" },
    { "type": "url", "id": "button_1_link", "label": "Bouton — lien", "default": "/collections/all" },
    { "type": "text", "id": "button_2_label", "label": "Lien — texte", "default": "عوالمنا" },
    { "type": "url", "id": "button_2_link", "label": "Lien — adresse", "default": "/collections" },
    { "type": "header", "content": "Visuel" },
    { "type": "image_picker", "id": "image", "label": "Photo du parfum (portrait)", "info": "Sans photo, une illustration des flacons Maison D'Arabie s'affiche sur le marbre." },
    { "type": "text", "id": "tag", "label": "Étiquette sur le visuel", "default": "تشكيلة جديدة" },
    { "type": "text", "id": "seal_text", "label": "Texte du sceau tournant", "info": "Laisser vide pour masquer le sceau.", "default": "100% أصلي • عطور أصلية •" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Atout",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Bouclier" },
            { "value": "truck", "label": "Camion" },
            { "value": "cash", "label": "Billet" },
            { "value": "gift", "label": "Cadeau" },
            { "value": "bottle", "label": "Flacon" },
            { "value": "drop", "label": "Goutte" },
            { "value": "award", "label": "Étoile" }
          ]
        },
        { "type": "text", "id": "text", "label": "Texte", "default": "أصلي 100%" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Héro",
      "blocks": [
        { "type": "fact", "settings": { "icon": "shield", "text": "أصلي 100%" } },
        { "type": "fact", "settings": { "icon": "cash", "text": "الدفع عند الاستلام" } },
        { "type": "fact", "settings": { "icon": "truck", "text": "58 ولاية" } }
      ]
    }
  ]
}
{% endschema %}

<section class="ban on-dark" style="--banner-h: {{ section.settings.height }}px">
  <div class="ban-media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '100vw', alt: '' }}
    {%- endif -%}
  </div>
  <div class="container ban-in">
    <div class="ban-card oct oct--dark reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow"><span class="idx">{{ section.settings.index | escape }}</span>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="display">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label | escape }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière (marbre)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond (optionnel)", "info": "Sans image : marbre noir veiné d'or." },
    { "type": "range", "id": "height", "min": 360, "max": 760, "step": 20, "unit": "px", "default": 520, "label": "Hauteur" },
    { "type": "text", "id": "index", "label": "Numéro de section", "default": "06" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "الهدايا" },
    { "type": "text", "id": "title", "label": "Titre", "default": "علب هدايا وتغليف فاخر" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "أضف تغليف الهدية إلى طلبك واكتب كلمة خاصة: العطر أجمل الرسائل." },
    { "type": "text", "id": "button_label", "label": "Bouton — texte", "default": "شاهد التشكيلة" },
    { "type": "url", "id": "button_link", "label": "Bouton — lien", "default": "/collections/all" }
  ],
  "presets": [
    { "name": "Bannière (marbre)" }
  ]
}
{% endschema %}

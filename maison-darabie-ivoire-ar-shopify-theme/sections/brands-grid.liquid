{%- if section.blocks.size > 0 -%}
  <section class="section sec-brands section--{{ section.settings.scheme }}" id="brands">
    <div class="container">
      <header class="sec-head reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow"><span class="idx">{{ section.settings.index | escape }}</span>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="display">{{ section.settings.title | escape }}</h2>
          {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
        </div>
      </header>
      <div class="brands">
        {%- for block in section.blocks -%}
          {%- liquid
            assign brand = block.settings.name
            if block.settings.collection != blank
              assign href = block.settings.collection.url
            else
              assign href = brand | url_for_vendor
            endif
          -%}
          <a class="brand-cell reveal" style="--d: {{ forloop.index0 | times: 70 }}ms" href="{{ href }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: class: 'brand-cell-img', loading: 'lazy', widths: '300, 600', sizes: '(min-width: 960px) 25vw, 50vw', alt: '' }}
            {%- endif -%}
            <span class="brand-cell-n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="brand-cell-name">{{ brand | escape }}</span>
            {%- if block.settings.tagline != blank -%}<span class="brand-cell-tag">{{ block.settings.tagline | escape }}</span>{%- endif -%}
            <svg class="ico brand-cell-go" aria-hidden="true"><use href="#i-arrow"/></svg>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Nos marques",
  "settings": [
    { "type": "text", "id": "index", "label": "Numéro de section", "default": "09" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "مختارات" },
    { "type": "text", "id": "title", "label": "Titre", "default": "ماركاتنا" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "أجمل توقيعات العطور الشرقية والعالمية." },
    { "type": "select", "id": "scheme", "label": "Fond", "default": "ivory", "options": [ { "value": "ivory", "label": "Ivoire" }, { "value": "sand", "label": "Sable" } ] }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom de la marque", "default": "ماركتي", "info": "Si aucune collection n'est choisie, le lien affiche tous les produits dont le « Fournisseur » porte ce nom (écriture identique)." },
        { "type": "collection", "id": "collection", "label": "Collection (optionnel)" },
        { "type": "text", "id": "tagline", "label": "Légende", "default": "عطور وعلب هدايا" },
        { "type": "image_picker", "id": "image", "label": "Image de fond (optionnel)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Nos marques", "blocks": [ { "type": "brand", "settings": { "name": "Marque 1", "tagline": "عطور وعلب هدايا" } }, { "type": "brand", "settings": { "name": "Marque 2", "tagline": "عطور وعلب هدايا" } }, { "type": "brand", "settings": { "name": "Marque 3", "tagline": "عطور وعلب هدايا" } }, { "type": "brand", "settings": { "name": "Marque 4", "tagline": "عطور وعلب هدايا" } } ] }
  ]
}
{% endschema %}

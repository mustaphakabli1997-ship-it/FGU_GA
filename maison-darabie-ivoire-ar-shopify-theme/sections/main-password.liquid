<section class="nf nf--card on-dark">
  <div class="nf-bg" aria-hidden="true"></div>
  <div class="nf-card oct">
    {% render 'brand', variant: 'stacked' %}
    <h1 class="display sm">{{ 'general.password_title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="lead rte">{{ shop.password_message }}</div>
    {%- else -%}
      <p class="lead">{{ 'general.password_text' | t }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'password-form' -%}
      <div class="nl-row">
        <label class="sr" for="password-field">{{ 'general.password_label' | t }}</label>
        <input id="password-field" type="password" name="password" autocomplete="current-password" required placeholder="{{ 'general.password_label' | t }}" dir="ltr">
        <button class="btn" type="submit"><span>{{ 'general.password_enter' | t }}</span></button>
      </div>
      {%- if form.errors -%}
        <p class="nl-msg err" role="alert">{{ 'general.password_error' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": []
}
{% endschema %}

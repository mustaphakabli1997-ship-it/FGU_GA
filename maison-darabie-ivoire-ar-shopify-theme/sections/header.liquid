<header class="hd" id="header" data-header>
  <div class="container hd-in">
    <button class="hd-menu icon-btn" type="button" data-menu-open aria-label="{{ 'general.menu' | t }}" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="ico" aria-hidden="true"><use href="#i-menu"/></svg>
    </button>

    {% render 'brand' %}

    <nav class="hd-nav" aria-label="{{ 'general.menu' | t }}">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"{% if link.active or link.child_active %} class="on" aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    </nav>

    <div class="hd-tools">
      {%- if localization.available_languages.size > 1 -%}
        {%- form 'localization', id: 'header-localization', class: 'lang-form' -%}
          <label class="sr" for="header-language">{{ 'general.language' | t }}</label>
          <select id="header-language" name="language_code" class="lang-select" data-auto-submit>
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
            {%- endfor -%}
          </select>
          <noscript><button class="lang-btn" type="submit">OK</button></noscript>
        {%- endform -%}
      {%- endif -%}
      <button class="icon-btn" type="button" data-search-open aria-label="{{ 'general.search' | t }}">
        <svg class="ico" aria-hidden="true"><use href="#i-search"/></svg>
      </button>
      {%- if section.settings.show_newsletter_bell -%}
        <a class="icon-btn bell-btn" href="{{ routes.root_url }}#club" aria-label="{{ 'newsletter.eyebrow' | t }}">
          <svg class="ico" aria-hidden="true"><use href="#i-bell"/></svg>
        </a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn account-btn" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">
          <svg class="ico" aria-hidden="true"><use href="#i-user"/></svg>
        </a>
      {%- endif -%}
      <a class="icon-btn cart-btn" href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'general.cart' | t }}">
        <svg class="ico" aria-hidden="true"><use href="#i-bag"/></svg>
        <span class="badge" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="mm" id="mobile-menu" hidden>
  <div class="mm-bg" aria-hidden="true"></div>
  <div class="mm-in">
    <div class="mm-top">
      <img class="mm-mono" src="{{ 'monogram.svg' | asset_url }}" alt="" width="56" height="56">
      <button class="icon-btn mm-close" type="button" data-menu-close aria-label="{{ 'general.close' | t }}">
        <svg class="ico" aria-hidden="true"><use href="#i-close"/></svg>
      </button>
    </div>
    <nav class="mm-links" aria-label="{{ 'general.menu' | t }}">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"><span class="mm-n">{{ forloop.index | prepend: '0' }}</span><span>{{ link.title | escape }}</span></a>
      {%- endfor -%}
    </nav>
    <div class="mm-foot">
      {%- if settings.contact_phone != blank -%}<a href="tel:{{ settings.contact_phone | replace: ' ', '' }}" dir="ltr">{{ settings.contact_phone | escape }}</a>{%- endif -%}
      {%- if settings.contact_email != blank -%}<a href="mailto:{{ settings.contact_email }}" dir="ltr">{{ settings.contact_email | escape }}</a>{%- endif -%}
      {%- if section.settings.show_newsletter_bell -%}
        <a class="mm-nl" href="{{ routes.root_url }}#club"><svg class="ico" aria-hidden="true"><use href="#i-bell"/></svg>{{ 'newsletter.eyebrow' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<div class="so" id="search-overlay" role="dialog" aria-modal="true" aria-label="{{ 'general.search' | t }}" hidden>
  <div class="container so-in">
    <button class="icon-btn so-close" type="button" data-search-close aria-label="{{ 'general.close' | t }}"><svg class="ico" aria-hidden="true"><use href="#i-close"/></svg></button>
    <form class="so-field" action="{{ routes.search_url }}" method="get" role="search">
      <label class="so-label" for="search-input">{{ 'search.title' | t }}</label>
      <input id="search-input" type="search" name="q" autocomplete="off" placeholder="{{ 'search.placeholder' | t }}">
      <input type="hidden" name="type" value="product">
      <button class="so-go" type="submit" aria-label="{{ 'search.title' | t }}"><svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></button>
    </form>
    <p class="so-hint">{{ 'search.hint' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu principal", "default": "main-menu" },
    { "type": "checkbox", "id": "show_newsletter_bell", "label": "Afficher la cloche d'inscription à la newsletter", "default": false }
  ]
}
{% endschema %}

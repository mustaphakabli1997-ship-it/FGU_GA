{{ 'chakib.css' | asset_url | stylesheet_tag }}

<section class="ck-hero" data-ck-hero lang="fr">
  <div class="ck-hero__fallback" data-name="{{ shop.name }}"></div>
  <canvas class="ck-hero__canvas" aria-hidden="true"></canvas>
  {%- if section.settings.model_image != blank -%}
    {{ section.settings.model_image | image_url: width: 1200 | image_tag: class: 'ck-hero__model', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200', sizes: '(max-width: 749px) 100vw, 46vw', alt: section.settings.model_image.alt | default: shop.name }}
  {%- endif -%}
  <div class="ck-hero__content">
    <p class="ck-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="ck-hero__title">{{ section.settings.title }}</h1>
    <p class="ck-hero__sub">{{ section.settings.subtitle }}</p>
    <div class="ck-hero__actions">
      {%- if section.settings.cta_link != blank -%}
        <a class="ck-btn ck-btn--gold" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_link != blank -%}
        <a class="ck-btn" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
    }
  }
</script>
<script type="module" src="{{ 'chakib-hero.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Chakib 3D Hero",
  "settings": [
    { "type": "image_picker", "id": "model_image", "label": "Photo du mannequin (portrait 3:4)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CHAKIB" },
    { "type": "text", "id": "title", "label": "Title", "default": "Un monde d'élégance masculine" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "L'art du style gentleman" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Acheter maintenant" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Découvrir la collection" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Chakib 3D Hero" }]
}
{% endschema %}

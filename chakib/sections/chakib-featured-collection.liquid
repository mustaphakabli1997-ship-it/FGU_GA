<section class="ck-section">
  <h2 class="ck-section__title">{{ section.settings.title }}</h2>
  <div class="ck-grid">
    {%- for product in section.settings.collection.products limit: section.settings.limit -%}
      {% render 'chakib-product-card', product: product %}
    {%- else -%}
      <p>Sélectionnez une collection dans l'éditeur du thème.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Chakib Collection vedette",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Découvrir la collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Chakib Collection vedette" }]
}
{% endschema %}

{%- assign current = product.selected_or_first_available_variant -%}
<section class="ck-product">
  <div class="ck-product__gallery">
    {%- for media in product.media -%}
      {{ media | media_tag: image_size: '1000x', loading: 'lazy' }}
    {%- endfor -%}
  </div>
  <div class="ck-product__info">
    <h1>{{ product.title }}</h1>
    <p class="ck-product__price" data-ck-price>{{ current.price | money }}</p>
    {%- form 'product', product, id: 'ck-product-form' -%}
      {%- unless product.has_only_default_variant -%}
        <select name="id" aria-label="Variante">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" {% if variant == current %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
              {{ variant.title }}{% unless variant.available %} — Épuisé{% endunless %}
            </option>
          {%- endfor -%}
        </select>
      {%- else -%}
        <input type="hidden" name="id" value="{{ current.id }}">
      {%- endunless -%}
      <button type="submit" class="ck-btn ck-btn--gold ck-product__buy-inline" {% unless current.available %}disabled{% endunless %}>
        {%- if current.available -%}Ajouter au panier{%- else -%}Épuisé{%- endif -%}
      </button>
    {%- endform -%}
    <div class="ck-product__desc">{{ product.description }}</div>
    <details class="ck-acc">
      <summary>Livraison et retours</summary>
      <p>{{ section.settings.shipping_text }}</p>
    </details>
  </div>
</section>

{%- if product.collections.size > 0 -%}
  <section class="ck-section">
    <h2 class="ck-section__title">{{ section.settings.related_title }}</h2>
    <div class="ck-grid">
      {%- liquid
        assign shown = 0
        for item in product.collections.first.products
          if item.id != product.id and shown < 4
            render 'chakib-product-card', product: item
            assign shown = shown | plus: 1
          endif
        endfor
      -%}
    </div>
  </section>
{%- endif -%}

<script type="application/ld+json">{{ product | structured_data }}</script>

<div class="ck-sticky-cart">
  <div>
    <strong>{{ product.title }}</strong>
    <span data-ck-price>{{ current.price | money }}</span>
  </div>
  <button type="submit" form="ck-product-form" class="ck-btn ck-btn--gold" {% unless current.available %}disabled{% endunless %}>
    {%- if current.available -%}Ajouter{%- else -%}Épuisé{%- endif -%}
  </button>
</div>

<script>
  document.querySelector('#ck-product-form select[name="id"]')?.addEventListener('change', (e) => {
    const price = e.target.selectedOptions[0].dataset.price;
    document.querySelectorAll('[data-ck-price]').forEach((el) => (el.textContent = price));
  });
</script>

{% schema %}
{
  "name": "Chakib Produit",
  "settings": [
    { "type": "textarea", "id": "shipping_text", "label": "Livraison et retours", "default": "Les frais et délais de livraison sont calculés à la commande. Consultez notre politique de retour pour plus de détails." },
    { "type": "text", "id": "related_title", "label": "Titre des suggestions", "default": "Vous aimerez aussi" }
  ]
}
{% endschema %}

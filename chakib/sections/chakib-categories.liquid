<section class="ck-section">
  {%- if section.settings.title != blank -%}<h2 class="ck-section__title">{{ section.settings.title }}</h2>{%- endif -%}
  <div class="ck-cats">
    {%- for block in section.blocks -%}
      <a class="ck-cat" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(max-width: 749px) 50vw, 25vw', alt: block.settings.title }}
        {%- else -%}
          <div class="ck-cat__ph"></div>
        {%- endif -%}
        <span class="ck-cat__title">{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Chakib Catégories",
  "settings": [{ "type": "text", "id": "title", "label": "Titre", "default": "Nos univers" }],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (portrait 3:4)" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Costumes" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Chakib Catégories",
      "blocks": [
        { "type": "category", "settings": { "title": "Costumes" } },
        { "type": "category", "settings": { "title": "Chemises" } },
        { "type": "category", "settings": { "title": "Manteaux" } },
        { "type": "category", "settings": { "title": "Accessoires" } }
      ]
    }
  ]
}
{% endschema %}

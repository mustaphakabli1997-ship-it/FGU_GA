{%- assign collection_to_show = section.settings.collection | default: collections['all'] -%}

<section class="section" id="boutique">
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{% render 'icon', name: 'star', class: 'i--fill' %} {{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="title-chrome section__title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.show_view_all -%}
        <a class="btn btn--sm" href="{{ collection_to_show.url }}">Voir tout {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="grid">
      {%- assign shown = 0 -%}
      {%- for product in collection_to_show.products -%}
        {%- unless product.handle == settings.delivery_product_handle -%}
          {%- if shown < section.settings.product_count -%}
            {% render 'product-card', product: product %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- else -%}
        <p class="empty">Ajoutez vos produits dans la collection « {{ collection_to_show.title | default: 'Tous les produits' }} » pour les voir ici.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grille de produits",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La collection" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nouveautés" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Vide = tous les produits." },
    { "type": "range", "id": "product_count", "label": "Nombre de produits", "min": 4, "max": 24, "step": 4, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Afficher « Voir tout »", "default": true }
  ],
  "presets": [
    { "name": "Grille de produits" }
  ]
}
{% endschema %}

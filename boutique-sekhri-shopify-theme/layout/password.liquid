<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <title>{{ shop.name }}</title>
    {% render 'meta-tags' %}
    {% style %}
      @font-face { font-family: 'Montserrat'; src: url('{{ 'montserrat-latin.woff2' | asset_url }}') format('woff2'); font-weight: 400 900; font-display: swap; }
      @font-face { font-family: 'Anton'; src: url('{{ 'anton-latin.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'Cairo'; src: url('{{ 'cairo-arabic.woff2' | asset_url }}') format('woff2'); font-weight: 200 1000; font-display: swap; }
      :root { --orange: {{ settings.color_accent }}; --orange-2: {{ settings.color_accent_hover }}; --black: {{ settings.color_bg }}; --text: {{ settings.color_text }}; --silver: {{ settings.color_silver }}; }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password{% if request.locale.iso_code == 'ar' %} is-ar{% endif %}" data-route="password">
    {% render 'icons' %}
    <main id="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>

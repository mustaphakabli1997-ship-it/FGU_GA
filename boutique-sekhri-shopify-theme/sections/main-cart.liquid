<section class="page-head">
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><i>/</i><span>{{ 'cart.title' | t }}</span></nav>
    <h1 class="display">{{ 'cart.title' | t }}</h1>
  </div>
</section>

<section class="section no-top" data-cart-page>
  <div class="container">
    {%- if cart.item_count == 0 -%}
      <div class="empty wide">
        <svg class="ico big" aria-hidden="true"><use href="#i-bag"/></svg>
        <p>{{ 'cart.empty' | t }}</p>
        <a class="btn btn-primary" href="{{ routes.collections_url }}/all">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="checkout-grid">
        <div>
          {% render 'free-shipping' %}
          {% render 'cart-lines' %}
          <label class="field cart-note"><span>{{ 'cart.note' | t }}</span>
            <textarea name="note" rows="3" maxlength="300">{{ cart.note }}</textarea>
          </label>
        </div>
        <aside class="summary">
          <div class="sum-row total"><span>{{ 'cart.subtotal' | t }}</span><b><bdi dir="ltr" class="money">{{ cart.total_price | money }}</bdi></b></div>
          <p class="muted small">{{ 'cart.shipping_at_checkout' | t }}</p>
          <button class="btn btn-primary btn-block lg" type="submit" name="checkout">{{ 'cart.checkout' | t }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></button>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page panier",
  "settings": []
}
{% endschema %}

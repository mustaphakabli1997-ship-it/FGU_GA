{%- liquid
  assign source = section.settings.collection | default: collections['all']
  assign limit = section.settings.products_to_show
-%}
{%- if source.products_count > 0 or request.design_mode -%}
  <section class="section tight" id="{{ section.id }}">
    <div class="container">
      <header class="section-head row reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="display">{{ section.settings.title | escape }}</h2>
        </div>
        <a class="link-arrow" href="{{ source.url | default: routes.collections_url }}">{{ 'general.see_all' | t }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </header>
      <div class="grid">
        {%- for product in source.products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="card"><div class="card-media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Produits à la une",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Fraîchement arrivé" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nouveautés" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Sans choix : tous les produits, les plus récents d'abord (réglage de tri de la collection « Tous les produits »)." },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 2, "default": 8, "label": "Nombre de produits" }
  ],
  "presets": [
    { "name": "Produits à la une" }
  ]
}
{% endschema %}

{%- if section.blocks.size > 0 -%}
  <div class="announce" role="region" aria-label="{{ section.settings.label | escape }}">
    {%- if section.settings.link != blank -%}<a class="announce-link" href="{{ section.settings.link }}">{%- endif -%}
    <div class="announce-track">
      {%- for i in (1..4) -%}
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span><i>✦</i>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonces",
  "settings": [
    { "type": "text", "id": "label", "label": "Libellé d'accessibilité", "default": "Annonces" },
    { "type": "url", "id": "link", "label": "Lien (optionnel)" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison dans les 58 wilayas" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonces",
      "blocks": [
        { "type": "message", "settings": { "text": "Livraison dans les 58 wilayas" } },
        { "type": "message", "settings": { "text": "Paiement à la livraison" } },
        { "type": "message", "settings": { "text": "Rejoins le Club : sois averti à chaque nouveau produit" } }
      ]
    }
  ]
}
{% endschema %}

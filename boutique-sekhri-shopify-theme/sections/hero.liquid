<section class="hero" id="hero" data-hero>
  <div class="hero-bg" aria-hidden="true"><i class="glow g1"></i><i class="glow g2"></i><i class="streaks"></i></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hero-title">
        <span class="line outline reveal" style="--d: 80ms">{{ section.settings.title_outline | escape }}</span>
        <span class="line solid reveal" style="--d: 160ms">{{ section.settings.title_solid | escape }}</span>
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="hero-sub reveal" style="--d: 260ms">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      <div class="hero-cta reveal" style="--d: 340ms">
        {%- if section.settings.button_1_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.button_1_link | default: routes.collections_url }}">{{ section.settings.button_1_label | escape }} <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.button_2_link | default: routes.collections_url }}">{{ section.settings.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="hero-stats reveal" style="--d: 420ms">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              <dt><bdi dir="ltr">{{ block.settings.value | escape }}</bdi></dt>
              <dd>{{ block.settings.label | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="mark-stage">
        <svg class="hero-mark" viewBox="15 8 808 508"><use href="#sk-mark"/></svg>
      </div>
      {%- for i in (1..3) -%}
        {%- liquid
          assign key = 'image_' | append: i
          assign img = section.settings[key]
        -%}
        {%- if img != blank -%}
          <div class="float f{{ i }}">{{ img | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210, 420', alt: '' }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <a class="scroll-cue" href="#cats" data-scroll aria-label="{{ 'general.scroll' | t }}"><i></i></a>
</section>

{% schema %}
{
  "name": "Héro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Boutique Sekhri — Homme" },
    { "type": "text", "id": "title_outline", "label": "Titre — ligne contour", "default": "LUXURY" },
    { "type": "text", "id": "title_solid", "label": "Titre — ligne pleine", "default": "SPORTSWEAR" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Ensembles, tricots, joggers, shorts et pièces signature pour hommes de 19 à 50 ans. Une allure premium, livrée partout en Algérie." },
    { "type": "text", "id": "button_1_label", "label": "Bouton 1 — texte", "default": "Découvrir la collection" },
    { "type": "url", "id": "button_1_link", "label": "Bouton 1 — lien", "default": "/collections/all" },
    { "type": "text", "id": "button_2_label", "label": "Bouton 2 — texte", "default": "Nouveautés" },
    { "type": "url", "id": "button_2_link", "label": "Bouton 2 — lien", "default": "/collections/all" },
    { "type": "header", "content": "Visuels flottants (optionnel)" },
    { "type": "paragraph", "content": "Ajoute 1 à 3 photos de vêtements détourées (PNG fond transparent) autour du monogramme." },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (bas gauche)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (haut droite)" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3 (bas droite)" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre clé",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "value", "label": "Valeur", "default": "58" },
        { "type": "text", "id": "label", "label": "Légende", "default": "Wilayas livrées" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Héro",
      "blocks": [
        { "type": "stat", "settings": { "value": "58", "label": "Wilayas livrées" } },
        { "type": "stat", "settings": { "value": "19–50", "label": "Ans, tous les styles" } },
        { "type": "stat", "settings": { "value": "COD", "label": "Paiement à la livraison" } }
      ]
    }
  ]
}
{% endschema %}

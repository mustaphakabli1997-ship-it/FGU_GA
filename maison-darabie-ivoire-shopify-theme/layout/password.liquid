<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ivory }}">
    <title>{{ shop.name }}</title>
    {% render 'meta-tags' %}
    {% style %}
      @font-face { font-family: 'Marcellus'; src: url('{{ 'marcellus-latin.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'Jost'; src: url('{{ 'jost-latin.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: 'Reem Kufi'; src: url('{{ 'reem-kufi-arabic.woff2' | asset_url }}') format('woff2'); font-weight: 400 700; font-display: swap; }
      @font-face { font-family: 'Cairo'; src: url('{{ 'cairo-arabic.woff2' | asset_url }}') format('woff2'); font-weight: 200 1000; font-display: swap; }
      :root { --ivory: {{ settings.color_ivory }}; --sand: {{ settings.color_sand }}; --ink: {{ settings.color_ink }}; --gold: {{ settings.color_gold }}; --gold-light: {{ settings.color_gold_light }}; --gold-dark: {{ settings.color_gold_dark }}; --logo-h: {{ settings.logo_height | default: 44 }}px; --marble: url('{{ 'marble-black.jpg' | asset_url }}'); }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- if settings.custom_css != blank %}
      {% style %}{{ settings.custom_css | replace: '</style', '' }}{% endstyle %}
    {%- endif %}
    {{ content_for_header }}
  </head>
  <body class="template-password{% if settings.paper_grain %} has-grain{% endif %}{% if request.locale.iso_code == 'ar' %} is-ar{% endif %}" data-route="password">
    {% render 'icons' %}
    <main id="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>

<article>
  <section class="page-head">
    <div class="container ph-in">
      <nav class="crumbs" aria-label="breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><i>/</i><a href="{{ blog.url }}">{{ blog.title | escape }}</a><i>/</i><span>{{ article.title | escape }}</span></nav>
      <h1 class="display reveal">{{ article.title | escape }}</h1>
      <p class="ph-count">{{ article.published_at | time_tag: format: 'date' }}</p>
    </div>
  </section>
  <section class="section tight no-top">
    <div class="container narrow-text">
      {%- if article.image -%}
        <div class="article-image">{{ article.image | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 960px) 760px, 100vw', alt: article.image.alt | default: article.title }}</div>
      {%- endif -%}
      <div class="rte lead">{{ article.content }}</div>
    </div>
  </section>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}

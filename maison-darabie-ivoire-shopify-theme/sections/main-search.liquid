{%- paginate search.results by section.settings.results_per_page -%}
  <section class="page-head">
    <div class="container ph-in">
      <nav class="crumbs" aria-label="breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><i>/</i><span>{{ 'search.title' | t }}</span></nav>
      <h1 class="display reveal">{{ 'search.title' | t }}</h1>
      <form class="shop-search search-page-form" action="{{ routes.search_url }}" method="get" role="search">
        <svg class="ico" aria-hidden="true"><use href="#i-search"/></svg>
        <input name="q" type="search" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
        <input type="hidden" name="type" value="product">
      </form>
      {%- if search.performed -%}
        <p class="muted">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
      {%- endif -%}
    </div>
  </section>
  <section class="section tight no-top">
    <div class="container">
      {%- if search.performed and search.results_count > 0 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, index: forloop.index0 %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- elsif search.performed -%}
        <div class="empty wide"><svg class="ico big" aria-hidden="true"><use href="#i-search"/></svg><p>{{ 'search.no_results' | t }}</p></div>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Page de recherche",
  "settings": [
    { "type": "range", "id": "results_per_page", "min": 8, "max": 36, "step": 4, "default": 24, "label": "Résultats par page" }
  ]
}
{% endschema %}

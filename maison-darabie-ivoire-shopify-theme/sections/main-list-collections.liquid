<section class="page-head">
  <div class="container ph-in">
    <nav class="crumbs" aria-label="breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><i>/</i><span>{{ 'collection.all_categories' | t }}</span></nav>
    <h1 class="display reveal">{{ 'collection.all_categories' | t }}</h1>
    <p class="ph-count">{{ 'collection.universes' | t: count: collections.size }}</p>
  </div>
</section>
<section class="section tight no-top">
  <div class="container">
    <div class="ct-grid">
      {%- for collection in collections -%}
        {% render 'collection-tile', collection: collection, index: forloop.index0 %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Liste des collections",
  "settings": []
}
{% endschema %}

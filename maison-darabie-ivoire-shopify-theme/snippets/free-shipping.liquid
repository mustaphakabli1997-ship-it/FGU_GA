{%- comment -%} Progress bar toward the free-shipping goal (display only). {%- endcomment -%}
{%- assign goal = settings.free_shipping_threshold | default: 0 | times: 100 -%}
{%- if goal > 0 -%}
  {%- liquid
    assign pct = cart.total_price | times: 100 | divided_by: goal | round
    if pct > 100
      assign pct = 100
    endif
    assign left = goal | minus: cart.total_price
  -%}
  <div class="freebar">
    <p>
      {%- if left > 0 -%}
        {{ 'cart.free_left_before' | t }} {% render 'money', amount: left %} {{ 'cart.free_left_after' | t }}
      {%- else -%}
        <b>{{ 'cart.free_reached' | t }}</b>
      {%- endif -%}
    </p>
    <div class="freebar-track"><i style="width: {{ pct }}%"></i></div>
  </div>
{%- endif -%}
